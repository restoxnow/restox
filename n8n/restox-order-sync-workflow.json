      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 520],
      "continueOnFail": true,
      "parameters": {
        "method": "POST",
        "url": "https://restox.net/api/retailers/order-history/sync",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer b431e44d01c09348acf88c591ec9d88c759fbac2780a624382e93121b9490ad9"
            },
