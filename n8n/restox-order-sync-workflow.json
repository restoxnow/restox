        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"user_id\": \"{{ $json.user_id }}\"\n}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "3f1a2b4c-0007-4e00-8000-100000000007",
      "name": "Track Sync Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 700],
      "parameters": {
        "jsCode": "const errors = $workflow.staticData.syncErrors || [];\nfor (const item of $input.all()) {\n  if (item.json.error) {\n    errors.push({\n      timestamp: new Date().toISOString(),\n      error: typeof item.json.error === 'string'\n        ? item.json.error\n        : JSON.stringify(item.json.error)\n    });\n  }\n}\n$workflow.staticData.syncErrors = errors;\nreturn $input.all();"
      }
    },
    {
      "id": "3f1a2b4c-0008-4e00-8000-100000000008",
      "name": "Wait 2 Seconds",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 880],
      "webhookId": "3f1a2b4c-wait-4e00-8000-100000000008",
      "parameters": {
        "resume": "timeInterval",
        "amount": 2,
        "unit": "seconds"
      }
    },
    {
      "id": "3f1a2b4c-0009-4e00-8000-100000000009",
      "name": "Get Error Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 340],
      "parameters": {
        "jsCode": "const errors = $workflow.staticData.syncErrors || [];\n$workflow.staticData.syncErrors = [];\nreturn [{ json: { errorCount: errors.length, errors: errors } }];"
      }
    },
    {
