    {
      "id": "3f1a2b4c-0003-4e00-8000-100000000003",
      "name": "Deduplicate Users",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 340],
      "parameters": {
        "jsCode": "const seen = new Set();\nconst unique = [];\nfor (const item of $input.all()) {\n  const uid = item.json.user_id;\n  if (uid && !seen.has(uid)) {\n    seen.add(uid);\n    unique.push({ json: { user_id: uid } });\n  }\n}\nreturn unique;"
      }
    },
    {
      "id": "3f1a2b4c-0004-4e00-8000-100000000004",
      "name": "Init Error Tracker",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 340],
      "parameters": {
        "jsCode": "$workflow.staticData.syncErrors = [];\nreturn $input.all();"
      }
    },
    {
      "id": "3f1a2b4c-0005-4e00-8000-100000000005",
      "name": "Loop Users",
      "type": "n8n-nodes-base.splitInBatches",
