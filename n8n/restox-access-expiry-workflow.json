{
  "name": "Restox – Access Code Expiry",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 6 * * *" }]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily 6AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/users",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "id,plan_tier,focus_group_access_expires_at" },
            { "name": "focus_group_access_expires_at", "value": "lt.{{ new Date().toISOString() }}" },
            { "name": "plan_tier", "value": "neq.free" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "fetch-expired-users",
      "name": "Fetch Expired Users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "const users = $input.all().map(i => i.json);\nconst staticData = $getWorkflowStaticData('global');\nstaticData.errorCount = 0;\nstaticData.processedCount = 0;\nreturn users.map(u => ({ json: u }));"
      },
      "id": "init-processing",
      "name": "Init Processing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
      "id": "split-batches",
      "name": "Split in Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [960, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/users",
        "method": "PATCH",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "=eq.{{ $json.id }}" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"plan_tier\": \"free\", \"focus_group_access_expires_at\": null }",
        "options": {}
      },
      "id": "revert-plan",
      "name": "Revert Plan to Free",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 180]
    },
    {
      "parameters": {
        "url": "https://api.sendgrid.com/v3/mail/send",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.SENDGRID_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"personalizations\": [{ \"to\": [{ \"email\": \"{{ $json.email }}\" }] }],\n  \"from\": { \"email\": \"hello@restox.net\", \"name\": \"Restox\" },\n  \"subject\": \"Your Restox focus group access has expired\",\n  \"content\": [{\n    \"type\": \"text/html\",\n    \"value\": \"<p>Hi there,</p><p>Your 2-month focus group Pro access to Restox has expired. Your account has been moved back to the Free plan.</p><p>We hope you enjoyed using Restox! If you'd like to continue with full automation and all features, you can <a href='https://restox.net/dashboard/settings?tab=billing'>upgrade to a paid plan</a> anytime.</p><p>Thanks for being part of our focus group — your feedback means a lot to us.</p><p>— The Restox Team</p>\"\n  }]\n}",
        "options": {}
      },
      "id": "send-expiry-email",
      "name": "Send Expiry Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 180]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.processedCount = (staticData.processedCount || 0) + 1;\nreturn $input.all();"
      },
      "id": "track-processed",
      "name": "Track Processed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $getWorkflowStaticData('global').errorCount }}",
              "rightValue": 5,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-errors",
      "name": "Check Error Count",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1920, 300]
    },
    {
      "parameters": {
        "url": "REPLACE_WITH_YOUR_SLACK_WEBHOOK_URL",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"text\": \":rotating_light: Restox Access Expiry: {{ $getWorkflowStaticData('global').errorCount }} errors during expiry processing. Check workflow logs.\" }",
        "options": {}
      },
      "id": "slack-alert",
      "name": "Slack Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2160, 180]
    },
    {
      "parameters": {
        "jsCode": "// Catch errors and increment error count\nconst staticData = $getWorkflowStaticData('global');\nstaticData.errorCount = (staticData.errorCount || 0) + 1;\nreturn [];"
      },
      "id": "handle-error",
      "name": "Handle Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 420]
    }
  ],
  "connections": {
    "Daily 6AM": { "main": [[{ "node": "Fetch Expired Users", "type": "main", "index": 0 }]] },
    "Fetch Expired Users": { "main": [[{ "node": "Init Processing", "type": "main", "index": 0 }]] },
    "Init Processing": { "main": [[{ "node": "Split in Batches", "type": "main", "index": 0 }]] },
    "Split in Batches": { "main": [[{ "node": "Revert Plan to Free", "type": "main", "index": 0 }]] },
    "Revert Plan to Free": { "main": [[{ "node": "Send Expiry Email", "type": "main", "index": 0 }]] },
    "Send Expiry Email": { "main": [[{ "node": "Track Processed", "type": "main", "index": 0 }]] },
    "Track Processed": { "main": [[{ "node": "Check Error Count", "type": "main", "index": 0 }]] },
    "Check Error Count": {
      "main": [
        [{ "node": "Slack Alert", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "meta": { "templateCredsSetupCompleted": true },
  "pinData": {}
}
