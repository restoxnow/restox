{
  "manifest_version": 3,
  "name": "Restox",
  "version": "1.0.0",
  "description": "Add products to Restox and automate your repeat purchases",
  "permissions": ["storage", "activeTab", "scripting", "identity"],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.walmart.com/*",
    "https://*.target.com/*",
    "https://*.costco.com/*",
    "https://*.chewy.com/*",
    "https://*.homedepot.com/*",
    "https://*.lowes.com/*",
    "https://*.sephora.com/*",
    "https://*.staples.com/*",
    "https://*.kroger.com/*",
    "https://*.instacart.com/*",
    "https://*.albertsons.com/*",
    "https://*.stopandshop.com/*",
    "https://*.wegmans.com/*",
    "https://*.samsclub.com/*",
    "https://*.uline.com/*",
    "https://*.grainger.com/*",
    "https://*.officedepot.com/*",
    "https://restox.net/*",
    "https://*.restox.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.walmart.com/*",
        "https://*.target.com/*",
        "https://*.costco.com/*",
        "https://*.chewy.com/*",
        "https://*.homedepot.com/*",
        "https://*.lowes.com/*",
        "https://*.sephora.com/*",
        "https://*.staples.com/*",
        "https://*.kroger.com/*",
        "https://*.instacart.com/*",
        "https://*.albertsons.com/*",
        "https://*.stopandshop.com/*",
        "https://*.wegmans.com/*",
        "https://*.samsclub.com/*",
        "https://*.uline.com/*",
        "https://*.grainger.com/*",
        "https://*.officedepot.com/*"
      ],
      "js": ["retailers.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://restox.net/*", "https://*.restox.net/*"],
      "js": ["auth-sync.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["logo.png", "icon.png", "icon16.png", "icon48.png", "icon128.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
